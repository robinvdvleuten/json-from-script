{
  "name": "json-from-script",
  "version": "3.1.0",
  "description": "Tiny JSON parser for your CSP aware script tags",
  "license": "MIT",
  "author": "Robin van der Vleuten <robin@webstronauts.com>",
  "type": "module",
  "source": "src/index.js",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "./index.d.ts",
  "exports": {
    "types": "./index.d.ts",
    "import": "./dist/index.js",
    "require": "./dist/index.cjs"
  },
  "files": [
    "index.d.ts",
    "dist"
  ],
  "size-limit": [
    {
      "path": "dist/index.js",
      "limit": "0.5 kB"
    },
    {
      "path": "dist/index.cjs",
      "limit": "0.5 kB"
    }
  ],
  "scripts": {
    "build": "tsdown",
    "prepublish": "npm run build",
    "size": "size-limit",
    "test": "uvu test"
  },
  "devDependencies": {
    "@size-limit/file": "^13.0.1",
    "jsdom": "^30.0.0",
    "size-limit": "^12.1.0",
    "tsdown": "^0.22.12",
    "uvu": "^0.5.6"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/robinvdvleuten/json-from-script.git"
  },
  "bugs": {
    "url": "https://github.com/robinvdvleuten/json-from-script/issues"
  },
  "homepage": "https://github.com/robinvdvleuten/json-from-script#readme"
}
